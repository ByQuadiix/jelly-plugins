<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Jellyfin.Plugin.Mp3Extractor</AssemblyName>
    <RootNamespace>Jellyfin.Plugin.Mp3Extractor</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Version>1.0.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Jellyfin SDK references (provided at runtime by the server, so PrivateAssets=All) -->
    <PackageReference Include="Jellyfin.Controller" Version="10.9.11" PrivateAssets="All" />
    <PackageReference Include="Microsoft.AspNetCore.Authorization" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  <!-- Embed web resources into the assembly -->
  <ItemGroup>
    <EmbeddedResource Include="Web\**\*" />
  </ItemGroup>

</Project>
